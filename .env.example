# Sao chép file này thành .env.local rồi điền giá trị từ
# Firebase Console → Project settings → Your apps → Web app → SDK setup and configuration.
# Đây là cấu hình công khai của client, không phải khoá bí mật — nhưng .env.local vẫn
# nằm trong .gitignore vì nó gắn với project cụ thể của bạn.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check — BẮT BUỘC nếu muốn dùng Trợ lý AI.
# Firebase AI Logic từ chối phục vụ project chưa enforce App Check.
# Provider duy nhất còn dùng được là reCAPTCHA Enterprise (classic v3 đã bị khai tử).
# Site key tạo ở Google Cloud Console → Fraud Defense → Create key (Website, Score-based),
# rồi dán vào Firebase Console → Build → App Check → app web → reCAPTCHA Enterprise.
# Đây là khoá công khai, không có secret key đi kèm.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Bắt buộc "true" khi dùng Enterprise — tức là mọi cấu hình mới hiện nay.
VITE_FIREBASE_APPCHECK_ENTERPRISE=true

# Tuỳ chọn — model Gemini dùng cho Trợ lý AI (mặc định: gemini-3.5-flash)
VITE_GEMINI_MODEL=

# Backend phục vụ Gemini: "vertex" (mặc định) hoặc "google".
#   vertex — Vertex AI Gemini API, tức "Agent Platform" theo tên mới của Google.
#            Firebase Console → AI Logic → chọn Vertex AI, nó tự bật API cần thiết.
#   google — Gemini Developer API, đường cũ.
# Cùng SDK, cùng schema, cùng câu trả lời; khác nhau ở API nào phải bật trên
# project và có ghim vùng chạy hay không.
VITE_FIREBASE_AI_BACKEND=vertex

# Vùng chạy cho Vertex AI. Bỏ trống = mặc định của SDK, và đó là lựa chọn đúng
# nếu bạn không có ràng buộc về nơi dữ liệu được xử lý. Ghim một vùng chưa bật
# thì request đầu tiên trả 404.
# Danh sách: https://firebase.google.com/docs/ai-logic/locations?api=vertex
VITE_FIREBASE_AI_LOCATION=

# ── Goong ────────────────────────────────────────────────────────────────────
# Goong cấp HAI khoá khác nhau ở https://account.goong.io và chúng không thay
# nhau được. Điền cái nào thì được tính năng của cái đó; bỏ trống cả hai thì
# app chạy đúng như trước: tìm địa điểm bằng Nominatim, bản đồ nền
# OpenStreetMap, đường nối các điểm dừng là đường chim bay.

# Khoá API (rsapi.goong.io) — tìm địa điểm cho ô "Tên điểm dừng", đường đi thật
# giữa các điểm dừng, và khoảng cách đường bộ cho nút "Tối ưu tuyến đường".
VITE_GOONG_API_KEY=

# Khoá Maptiles (tiles.goong.io) — bản đồ nền của Goong, biết tên đường và tên
# quán ở Việt Nam kỹ hơn OpenStreetMap. Khoá sai hoặc hết hạn thì bản đồ tự
# quay về OpenStreetMap chứ không để trắng.
VITE_GOONG_MAPTILES_KEY=

# Tuỳ chọn — kiểu bản đồ Goong. Một trong: goong_light_v2 (mặc định),
# goong_map_web, goong_map_dark, navigation_day, navigation_night.
# Gõ sai tên thì rơi về goong_light_v2, không phải bản đồ trắng.
VITE_GOONG_MAP_STYLE=
