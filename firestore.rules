rules_version = '2';

/* SmartTrip — Firestore Security Rules

   Access is decided entirely from three mirrors kept on the trip document:
     memberIds     : [uid]           who may read
     roles         : { uid: role }   what each of them may do
     pendingEmails : [email]         invited, not yet signed in and seated

   They are denormalised off `members` so a rule never has to read a second
   document. The catch is that anyone who can write the trip could rewrite
   their own role, so updates below explicitly forbid touching those fields
   unless the caller is the owner — or is claiming their own invitation, which
   is allowed but pinned down field by field. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      function trip()     { return resource.data; }
      function incoming() { return request.resource.data; }
      function uid()      { return request.auth.uid; }
      function signedIn() { return request.auth != null; }

      function isMember() { return signedIn() && uid() in trip().memberIds; }
      function myEmail()  { return request.auth.token.email.lower(); }

      /* An invited person is not a member yet, so they need read access to find
         the trip that is waiting for them. Only a verified address counts —
         otherwise anyone could sign up as someone else and walk in. */
      function isInvited() {
        return signedIn()
            && request.auth.token.get('email_verified', false) == true
            && myEmail() in resource.data.get('pendingEmails', []);
      }
      function role()     { return trip().roles[uid()]; }
      function isOwner()  { return isMember() && role() == 'owner'; }
      function isEditor() { return isMember() && (role() == 'owner' || role() == 'edit'); }

      /* Fields that decide access; only the owner may move them.

         `members` belongs in here too, even though it is not read by any rule.
         It is the source the three mirrors are derived from, so an editor left
         free to rewrite it could desync them: empty the list and the trip
         vanishes from everybody's screen (the client drops a trip with no
         members) while the document sits in Firestore untouched, or rewrite
         the owner's row and their name and email are whatever the editor says.
         `pendingEmails` likewise — an editor who can add an address to it is
         handing a stranger read access to the whole trip. */
      function accessUnchanged() {
        return incoming().memberIds == trip().memberIds
            && incoming().roles == trip().roles
            && incoming().ownerId == trip().ownerId
            && incoming().members == trip().members
            && incoming().get('pendingEmails', []) == trip().get('pendingEmails', []);
      }

      /* Leaving a trip: the mirror image of claiming a seat, and the second
         write a non-owner may make to these fields. It has to remove exactly
         the caller's own uid and role, drop exactly one row from `members`,
         and add or alter nothing — the set difference in the other direction
         has to be empty, so rows belonging to other people cannot be edited
         on the way out. The owner never reaches this path; they are already
         allowed everything by isOwner(), and the app keeps the button away
         from them because a trip with no owner has nobody to administer it.

         Known limit: rules cannot walk `members` to match a row against
         request.auth.uid, so this pins how many rows leave but not which one.
         A departing member could drop somebody else's row instead of their
         own. They gain nothing by it — the victim keeps their uid in
         memberIds and roles, so their access is intact — and the owner can
         re-add the row. Closing it properly needs the seat identity in the
         document key rather than inside a list. */
      function leavesOwnSeat() {
        return isMember() && role() != 'owner'
            && incoming().diff(trip()).affectedKeys()
                 .hasOnly(['members', 'memberIds', 'roles', 'updatedAt'])
            && incoming().memberIds.toSet() == trip().memberIds.toSet().difference([uid()].toSet())
            && incoming().roles.diff(trip().roles).affectedKeys().hasOnly([uid()])
            && !(uid() in incoming().roles)
            && incoming().members.size() == trip().members.size() - 1
            && incoming().members.toSet().difference(trip().members.toSet()).size() == 0;
      }

      /* Shape checks, not access checks — the difference matters because these
         apply to the owner too. An editor with a legitimate write is still a
         third party as far as the database is concerned: nothing stops them
         sending a 200 kB title or a `plan` of "xin chào" except this.

         What rules cannot do is walk a list, so `members` is checked for being
         a list of a sane length and no further; the per-row shape is repaired
         on the way in by backend/schema.js. Sizes are generous on purpose —
         they are there to stop absurdity, not to second-guess a long trip name.

         Every optional field goes through .get() with a default so a document
         written by an older build, before the field existed, stays editable. */
      function wellFormed() {
        return incoming().keys().hasAll(['title', 'members', 'memberIds', 'roles', 'ownerId'])
            && incoming().title is string
            && incoming().title.size() <= 200
            && incoming().members is list
            && incoming().members.size() <= 50
            && incoming().memberIds is list
            && incoming().memberIds.size() <= 50
            && incoming().roles is map
            && incoming().get('pendingEmails', []) is list
            && incoming().get('pendingEmails', []).size() <= 50
            && incoming().get('settled', {}) is map
            && incoming().get('plan', 0) is number
            && incoming().get('plan', 0) >= 0
            && incoming().get('body', '') is string
            && incoming().get('body', '').size() <= 2000
            && incoming().get('alt', '') is string
            && incoming().get('alt', '').size() <= 300
            && incoming().get('seed', '') is string
            && incoming().get('seed', '').size() <= 100;
      }

      /* Claiming an invitation: the one write a non-member may make. It has to
         add exactly the caller's own uid, remove exactly the caller's own
         email, and leave every other field of the trip alone — so it cannot be
         used to seat somebody else, hand yourself 'owner', or edit the trip. */
      function claimsOwnSeat() {
        return isInvited()
            && incoming().diff(trip()).affectedKeys()
                 .hasOnly(['members', 'memberIds', 'roles', 'pendingEmails', 'updatedAt'])
            && incoming().memberIds.toSet() == trip().memberIds.toSet().union([uid()].toSet())
            && incoming().get('pendingEmails', []).toSet()
                 == trip().get('pendingEmails', []).toSet().difference([myEmail()].toSet())
            && incoming().roles.diff(trip().roles).affectedKeys().hasOnly([uid()])
            && incoming().roles[uid()] in ['edit', 'view']
            && incoming().members.size() == trip().members.size();
      }

      allow read: if isMember() || isInvited();

      // a new trip must start with its creator as the only seated member
      allow create: if signedIn()
                    && wellFormed()
                    && incoming().ownerId == uid()
                    && incoming().memberIds == [uid()]
                    && incoming().roles[uid()] == 'owner';

      allow update: if wellFormed()
                    && (isOwner()
                        || (isEditor() && accessUnchanged())
                        || claimsOwnSeat()
                        || leavesOwnSeat());

      allow delete: if isOwner();

      /* Sub-collections inherit nothing, so each states its own rule. They read
         the parent trip once per request to find the caller's role. */
      function parent()      { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
      function canRead()     { return signedIn() && uid() in parent().memberIds; }
      function canWrite()    { return canRead() && parent().roles[uid()] in ['owner', 'edit']; }

      /* The children were unvalidated until now: `allow write: if canWrite()`
         let anyone with edit rights put anything of any shape in here. The
         client repairs what it reads, so it never showed — but repairing on
         read is the wrong end, and it does nothing about a document written
         large enough to be a problem for everyone who loads the trip.

         Stops live inside the day document as `items`, and rules cannot walk a
         list to check each one, so the cap is on how many there may be. */
      function dayWellFormed() {
        return incoming().get('items', []) is list
            && incoming().get('items', []).size() <= 100
            && incoming().get('place', '') is string
            && incoming().get('place', '').size() <= 200
            && incoming().get('seed', '') is string
            && incoming().get('seed', '').size() <= 100
            && incoming().get('order', 0) is number;
      }

      function expenseWellFormed() {
        return incoming().get('name', '') is string
            && incoming().get('name', '').size() <= 200
            && incoming().get('cat', '') is string
            && incoming().get('cat', '').size() <= 60
            && incoming().get('payerId', '') is string
            && incoming().get('payerId', '').size() <= 64
            && incoming().amount is number
            && incoming().amount >= 0;
      }

      /* The local guidebook: one document per destination inside the trip it
         was written for. It lives here rather than in a shared /guides
         collection on purpose — a collection anyone could write would let one
         person poison what everybody else reads, and rules cannot look inside
         the text to tell good content from bad. Duplicating Hội An across two
         trips is the cheaper mistake.

         Same limit as everywhere else: rules cannot walk a list, so the caps
         are on how many rows there may be. The length of each row is clipped
         on the way in and on the way out by backend/schema.js. */
      function guideWellFormed() {
        return incoming().get('dest', '') is string
            && incoming().get('dest', '').size() <= 200
            && incoming().get('lang', '') is string
            && incoming().get('lang', '').size() <= 100
            && incoming().get('currency', '') is string
            && incoming().get('currency', '').size() <= 200
            && incoming().get('summary', '') is string
            && incoming().get('summary', '').size() <= 2000
            && incoming().get('sections', []) is list
            && incoming().get('sections', []).size() <= 20
            && incoming().get('phrases', []) is list
            && incoming().get('phrases', []).size() <= 60
            && incoming().get('emergency', []) is list
            && incoming().get('emergency', []).size() <= 20
            && incoming().get('createdAt', 0) is number;
      }

      match /days/{dayId} {
        allow read: if canRead();
        allow create, update: if canWrite() && dayWellFormed();
        allow delete: if canWrite();
      }

      match /expenses/{expenseId} {
        allow read: if canRead();
        allow create, update: if canWrite() && expenseWellFormed();
        allow delete: if canWrite();
      }

      match /guide/{guideId} {
        allow read: if canRead();
        allow create, update: if canWrite() && guideWellFormed();
        allow delete: if canWrite();
      }
    }

    // anything not named above stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
