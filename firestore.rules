rules_version = '2';

/* SmartTrip — Firestore Security Rules

   Access is decided entirely from three mirrors kept on the trip document:
     memberIds     : [uid]           who may read
     roles         : { uid: role }   what each of them may do
     pendingEmails : [email]         invited, not yet signed in and seated

   They are denormalised off `members` so a rule never has to read a second
   document. The catch is that anyone who can write the trip could rewrite
   their own role, so updates below explicitly forbid touching those fields
   unless the caller is the owner — or is claiming their own invitation, which
   is allowed but pinned down field by field. */

service cloud.firestore {
  match /databases/{database}/documents {

    match /trips/{tripId} {
      function trip()     { return resource.data; }
      function incoming() { return request.resource.data; }
      function uid()      { return request.auth.uid; }
      function signedIn() { return request.auth != null; }

      function isMember() { return signedIn() && uid() in trip().memberIds; }
      function myEmail()  { return request.auth.token.email.lower(); }

      /* An invited person is not a member yet, so they need read access to find
         the trip that is waiting for them. Only a verified address counts —
         otherwise anyone could sign up as someone else and walk in. */
      function isInvited() {
        return signedIn()
            && request.auth.token.get('email_verified', false) == true
            && myEmail() in resource.data.get('pendingEmails', []);
      }
      function role()     { return trip().roles[uid()]; }
      function isOwner()  { return isMember() && role() == 'owner'; }
      function isEditor() { return isMember() && (role() == 'owner' || role() == 'edit'); }

      // fields that decide access; only the owner may move them
      function accessUnchanged() {
        return incoming().memberIds == trip().memberIds
            && incoming().roles == trip().roles
            && incoming().ownerId == trip().ownerId;
      }

      function wellFormed() {
        return incoming().keys().hasAll(['title', 'members', 'memberIds', 'roles', 'ownerId'])
            && incoming().title is string
            && incoming().members is list
            && incoming().memberIds is list
            && incoming().memberIds.size() <= 50;
      }

      /* Claiming an invitation: the one write a non-member may make. It has to
         add exactly the caller's own uid, remove exactly the caller's own
         email, and leave every other field of the trip alone — so it cannot be
         used to seat somebody else, hand yourself 'owner', or edit the trip. */
      function claimsOwnSeat() {
        return isInvited()
            && incoming().diff(trip()).affectedKeys()
                 .hasOnly(['members', 'memberIds', 'roles', 'pendingEmails', 'updatedAt'])
            && incoming().memberIds.toSet() == trip().memberIds.toSet().union([uid()].toSet())
            && incoming().get('pendingEmails', []).toSet()
                 == trip().get('pendingEmails', []).toSet().difference([myEmail()].toSet())
            && incoming().roles.diff(trip().roles).affectedKeys().hasOnly([uid()])
            && incoming().roles[uid()] in ['edit', 'view']
            && incoming().members.size() == trip().members.size();
      }

      allow read: if isMember() || isInvited();

      // a new trip must start with its creator as the only seated member
      allow create: if signedIn()
                    && wellFormed()
                    && incoming().ownerId == uid()
                    && incoming().memberIds == [uid()]
                    && incoming().roles[uid()] == 'owner';

      allow update: if wellFormed()
                    && (isOwner() || (isEditor() && accessUnchanged()) || claimsOwnSeat());

      allow delete: if isOwner();

      /* Sub-collections inherit nothing, so each states its own rule. They read
         the parent trip once per request to find the caller's role. */
      function parent()      { return get(/databases/$(database)/documents/trips/$(tripId)).data; }
      function canRead()     { return signedIn() && uid() in parent().memberIds; }
      function canWrite()    { return canRead() && parent().roles[uid()] in ['owner', 'edit']; }

      match /days/{dayId} {
        allow read: if canRead();
        allow write: if canWrite();
      }

      match /expenses/{expenseId} {
        allow read: if canRead();
        allow write: if canWrite();
      }
    }

    // anything not named above stays closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
